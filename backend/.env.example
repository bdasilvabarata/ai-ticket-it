# Puerto HTTP del servidor.
PORT=3000
# Interfaz de red donde escucha; 0.0.0.0 permite consultarlo desde otros dispositivos de la red local.
HOST=0.0.0.0
# Base MongoDB externa; si no se define, se usa MongoDB en memoria con datos de ejemplo.
# MONGO_URI=mongodb://localhost:27017/ai-ticket-it
# Nivel de registro: info o silent (en los tests es siempre silent).
LOG_LEVEL=info
